# Скопируйте в .env и заполните: cp .env.example .env

# PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL="postgresql://cyberlearn:cyberlearn@localhost:5432/cyberlearn?schema=public"

# JWT. Секреты не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-string-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Публичный адрес приложения
NEXT_PUBLIC_APP_URL="http://localhost:3000"
